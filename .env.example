# Copiar a ".env" y completar con valores reales. Nunca commitear ".env".

# Token del bot de Telegram (BotFather)
TELEGRAM_BOT_TOKEN=

# API key de Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# --- Cadena de fallback de vision (todo opcional) --------------------------
# Ver docs/ARQUITECTURA_FALLBACK_MULTIPROVEEDOR.md.
#
# Orden de intento, "proveedor:modelo" separado por comas. Si no se define, se
# usa esta cadena por defecto:
#   gemini:gemini-3.6-flash,gemini:gemini-3.8-flash,openai:gpt-5.6-terra,anthropic:claude-sonnet-5
# Un tier sin API key (o cuyo adaptador aun no existe) se omite con un INFO.
# VISION_CHAIN=

# OpenAI: tier 3 de la cadena por defecto (gpt-5.6-terra). Sin key, el tier se omite.
# OPENAI_API_KEY=
# OPENAI_REASONING_EFFORT=        (vacio = default del modelo)
# OPENAI_IMAGE_DETAIL=auto        (low | high | auto)
# OPENAI_STORE_RESPONSES=false    (false: OpenAI no guarda copia de las capturas)
# OPENAI_TIMEOUT_SECONDS=60       (TEMPORAL, ver arriba)
# OPENAI_MAX_ATTEMPTS=2
#
# Anthropic: tier 4 de la cadena por defecto (claude-sonnet-5). Sin key, el tier
# se omite. Solo se usa la key de este archivo: el adaptador ignora las
# variables ambientales del SDK (ANTHROPIC_AUTH_TOKEN, ANTHROPIC_BASE_URL...).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MAX_TOKENS=16000      (tokens de salida por solicitud, incluye razonamiento)
# ANTHROPIC_EFFORT=               (low | medium | high | xhigh | max; vacio = default del modelo)
# ANTHROPIC_TIMEOUT_SECONDS=60    (TEMPORAL, ver arriba)
# ANTHROPIC_MAX_ATTEMPTS=2
# Un 429 sin `retry-after` (ni el codigo documentado de tope de gasto) se trata
# como credito/gasto agotado y bloquea al proveedor hasta reiniciar. Heuristica
# NO verificada con una respuesta real; ponla en false si da falsos positivos.
# ANTHROPIC_TREAT_429_WITHOUT_RETRY_AFTER_AS_CREDIT=true

# Timeouts y reintentos, por proveedor. TEMPORAL: 60 s y 300 s son valores de la
# etapa de evaluacion LOCAL; deben bajar al desplegar en Render.
# GEMINI_TIMEOUT_SECONDS=60
# GEMINI_MAX_ATTEMPTS=1
# VISION_CHAIN_DEADLINE_SECONDS=300

# Cortacircuitos por tier y registro de intentos (JSONL sin contenido de las
# capturas; vacio desactiva el archivo).
# VISION_CIRCUIT_BREAKER_ENABLED=true
#
# Guardia de cuota (separado del cortacircuitos): salta un tier con CUOTA_DIARIA
# agotada hasta el proximo reset (Gemini: medianoche hora del Pacifico; otros
# proveedores: duracion fija en segundos) y un proveedor con CREDITO_O_GASTO
# agotado hasta reiniciar el proceso.
# VISION_QUOTA_GUARD_ENABLED=true
# VISION_DAILY_QUOTA_FALLBACK_BLOCK_SECONDS=21600
# VISION_ATTEMPTS_LOG_PATH=logs/vision_attempts.jsonl

# DEPRECADAS: alias de los tiers 1 y 2. Usa VISION_CHAIN.
# GEMINI_MODEL=
# GEMINI_FALLBACK_MODEL=

# Pruebas manuales (NUNCA en produccion): fuerza fallas sin gastar cuota.
# Formato proveedor[:modelo]=falla, p. ej. gemini:gemini-3.6-flash=503
# FORCE_VISION_ERROR=

PDF_REGION=Región Metropolitana
PDF_COUNTRY=Chile
LOG_LEVEL=INFO
